{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "moduleResolution": "Node",
    "module": "CommonJS",
    "verbatimModuleSyntax": false,
    "rootDir": "src",
    "noEmit": false
